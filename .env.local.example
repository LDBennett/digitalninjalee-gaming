# Supabase - get these from your project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://project-id.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=publishable-key

# RAWG - https://rawg.io/apidocs
RAWG_API_KEY=your-rawg-api-key

# IGDB (via Twitch) - https://api-docs.igdb.com/#getting-started
# These are Twitch developer app credentials — same thing as "IGDB credentials"
IGDB_CLIENT_ID=your-twitch-client-id
IGDB_CLIENT_SECRET=your-twitch-client-secret

# Supabase service role - only needed for admin scripts, never expose to client
# Dashboard → Settings → API → service_role secret
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Cloudflare Turnstile - https://dash.cloudflare.com/ → Turnstile
# Use test keys for local dev: site key 1x00000000000000000000AA, secret 1x0000000000000000000000000000000AA
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Google Analytics 4 - https://analytics.google.com/
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Discord play-activity tracking - see docs/discord-activity.md
# Bot token from discord.com/developers (Presence Intent must be enabled)
DISCORD_BOT_TOKEN=
# Your Discord user ID (Developer Mode -> right-click yourself -> Copy User ID)
DISCORD_USER_ID=
# Optional: the private server the bot lives in (right-click server -> Copy Server ID)
DISCORD_GUILD_ID=
# Shared secret between Supabase Cron and /api/cron/discord-poll (openssl rand -hex 32)
CRON_SECRET=
